# ── Servidor ─────────────────────────────────────────────
PORT=3000
# App de escritorio: puerto fijo (los webhooks y la API quedan en http://127.0.0.1:<puerto>).
# Por defecto 3100 (distinto de PORT para poder tener a la vez «npm run dev»). 0 = uno libre cada vez.
ORQ_DESKTOP_PORT=3100
# URL pública (se usa en enlaces de notificaciones de aprobación)
PUBLIC_URL=http://localhost:3000
# Fichero SQLite donde se guardan workflows, ejecuciones y logs
DB_FILE=./data/orquesta.db
# Si se define, la API y la UI exigen "Authorization: Bearer <API_TOKEN>"
API_TOKEN=
# Token que deben presentar los workers. Si se deja vacío se genera uno temporal en cada
# arranque y solo el worker embebido puede conectarse (lo más seguro en local).
WORKER_TOKEN=
# Interfaz de red. 127.0.0.1 = solo este equipo. Usa 0.0.0.0 únicamente en Docker o detrás
# de un proxy, y define entonces API_TOKEN y WORKER_TOKEN.
HOST=127.0.0.1
# Nombres de host y orígenes extra aceptados (por defecto solo localhost / 127.0.0.1).
# Protegen frente a DNS rebinding y frente a webs que intenten llamar a la API desde el navegador.
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# ── Worker embebido (corre dentro del servidor) ─────────
# Pon "false" para usar solo workers externos
EMBEDDED_WORKER=true
# Capacidades del worker embebido. "llm" incluye siempre el proveedor simulado (sin coste);
# los proveedores reales solo si están configurados abajo.
EMBEDDED_WORKER_CAPS=node,db,llm
EMBEDDED_WORKER_MAX=4

# ── Workers externos (npm run worker) ───────────────────
ORQ_URL=ws://localhost:3000/ws/worker
WORKER_ID=worker-01
# llm = agentes IA · node = scripts, HTTP, email · db = bases de datos
WORKER_CAPS=llm,node,db
WORKER_MAX=4
# true = aplica los permisos de carpetas/comandos que concede el usuario en el orquestador (y le
# pregunta los que falten). false = solo los de ORQ_FILES_ALLOW / ORQ_COMMANDS_ALLOW de este .env.
# El worker embebido siempre los aplica.
WORKER_ACCEPT_GRANTS=false

# ── Agentes IA: proveedores LLM ─────────────────────────
# Lista JSON de proveedores. La clave NUNCA va en el JSON: «keyEnv» es el nombre de la
# variable que la contiene. Tipos:
#   anthropic → API de Anthropic o un gateway compatible (Messages API)
#   openai    → /v1/chat/completions: OpenAI, LiteLLM (Claude, GPT y Gemini por el mismo
#               gateway), Gemini (baseUrl https://generativelanguage.googleapis.com/v1beta/openai)
#               u OpenRouter (baseUrl https://openrouter.io/api/v1)
#   mock      → simulado, sin coste ni red (siempre disponible)
#
# Opción A · cuenta de servicio propia de Orquesta (clave en este .env):
#   ORQ_LLM_PROVIDERS=[{"id":"gateway","label":"Gateway (cuenta de servicio)","kind":"openai","baseUrl":"https://gateway.miempresa.com","keyEnv":"ORQ_GATEWAY_SA_KEY","defaultModel":"claude-haiku-4-5-20251001"}]
#   ORQ_GATEWAY_SA_KEY=sk-...
#
# Opción B · heredar la clave del shell (p.ej. la de tu sesión de desarrollo). Desactivado
# salvo que pongas ORQ_LLM_ALLOW_SHELL=true; la UI avisa en todo momento cuando ocurre.
#   ORQ_LLM_PROVIDERS=[{"id":"shell","label":"Gateway (clave del shell)","kind":"anthropic","baseUrlEnv":"ANTHROPIC_BASE_URL","keyEnv":"ANTHROPIC_API_KEY","defaultModel":"claude-haiku-4-5-20251001"}]
#   ORQ_LLM_ALLOW_SHELL=true
#
# Opción C · OpenRouter (acceso a 200+ modelos con una sola API):
#   ORQ_LLM_PROVIDERS=[{"id":"openrouter","label":"OpenRouter","kind":"openai","baseUrl":"https://openrouter.io/api/v1","keyEnv":"OPENROUTER_API_KEY","defaultModel":"openai/gpt-4o-mini"}]
#   OPENROUTER_API_KEY=sk-or-...
#
# Opción D · OpenCode Go (https://opencode.ai/console; Messages API, como Anthropic).
# El worker envía automáticamente la cabecera x-opencode-session que este servicio exige:
#   ORQ_LLM_PROVIDERS=[{"id":"opencode-go","label":"OpenCode Go","kind":"anthropic","baseUrl":"https://opencode.ai/inference/go","keyEnv":"OPENCODE_API_KEY","defaultModel":"claude-haiku-5-5"}]
#   OPENCODE_API_KEY=sk-...
ORQ_LLM_PROVIDERS=[]
ORQ_LLM_ALLOW_SHELL=false
# Proveedor y modelo de los nodos Agente que no eligen uno: "proveedor:modelo".
# Vacío = simulado. Para pruebas reales baratas: gateway:claude-haiku-4-5-20251001
ORQ_LLM_DEFAULT=
# Límites de coste y tamaño
ORQ_LLM_MAX_INPUT_CHARS=400000
ORQ_LLM_MAX_TOKENS_PER_RUN=500000
# Dominios que la herramienta http_request de los agentes puede llamar (vacío = desactivada).
# Nunca se permiten IPs internas (localhost, 10.x, 192.168.x…). Ej: api.github.com,*.atlassian.net
ORQ_AGENT_HTTP_ALLOW=

# ── Email (nodo Email y notificaciones de aprobación) ───
# Sin SMTP_URL los emails se simulan (se registran pero no se envían)
# Ejemplo: smtps://usuario:clave@smtp.proveedor.com:465
SMTP_URL=
SMTP_FROM=Orquesta <no-reply@tudominio.com>

# ── Slack (notificaciones de aprobación) ────────────────
SLACK_WEBHOOK_URL=

# ── Webhooks ────────────────────────────────────────────
# Para nodos Webhook con autenticación "API key" (cabecera x-api-key)
WEBHOOK_API_KEY=
# Para nodos Webhook con autenticación "HMAC" (cabecera x-signature: sha256=<hex>)
WEBHOOK_HMAC_SECRET=

# ── Bases de datos (nodo Base de datos) ─────────────────
# Lo normal es darlas de alta en la pantalla «Conexiones». Aquí, opcionalmente, en JSON:
# nombre -> { driver: "pg" | "sqlite", url | file, readOnly }. Rutas relativas: desde la carpeta de datos.
DB_CONNECTIONS={"principal":{"driver":"sqlite","file":"./data/app.db"}}

# ── Ficheros y comandos: permisos fijos (opcional) ──────
# Lo normal es concederlos desde la UI: pantalla «Permisos», o al ejecutar, cuando un nodo o un
# agente necesita una carpeta o un comando, te lo pide («Permitir siempre» / «Solo esta vez»).
# Aquí, opcionalmente, permisos fijos que no se pueden revocar desde la UI:
# carpetas con lectura y escritura (rutas absolutas separadas por «;»). Nada fuera de las carpetas
# permitidas es accesible (ni con «..» ni enlaces).
# Ej: ORQ_FILES_ALLOW=C:\Users\tu-usuario\orquesta-poc
ORQ_FILES_ALLOW=
ORQ_FILES_MAX_BYTES=5242880
# También limitan las herramientas listar_ficheros / leer_fichero de los agentes (nunca leen .env,
# claves .pem/.key ni similares) y la carpeta de trabajo de los comandos.

# Comandos (nodo Comando y herramienta ejecutar_comando) permitidos en cualquier carpeta permitida,
# escritos EXACTAMENTE como se ejecutarán, separados por «;».
# Al proceso no le llegan las variables con secretos (KEY, TOKEN, PASS…, ANTHROPIC_*, ORQ_*…).
# Ej: ORQ_COMMANDS_ALLOW=npm test;npm run lint
ORQ_COMMANDS_ALLOW=
# Tiempo máximo de cada comando lanzado por un agente (el nodo Comando usa su propio timeout)
ORQ_COMMANDS_TIMEOUT_MS=600000

# Variables con prefijo ORQ_ quedan disponibles en expresiones ($env) y scripts (env),
# salvo ORQ_LLM_* y las que contienen KEY, TOKEN, SECRET, PASS o CRED
# ORQ_SOPORTE_EMAIL=soporte@tudominio.com
# Permite require() dentro de nodos Node.js (solo en entornos de confianza)
ORQ_ALLOW_REQUIRE=false
